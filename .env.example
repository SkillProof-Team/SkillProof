# 后端应用名称
APP_NAME=SkillProof

# 本机编译预览；开发时改为 http://127.0.0.1:5173
SKILLPROOF_ENV=development
SKILLPROOF_COOKIE_SECURE=0
SKILLPROOF_ALLOWED_HOSTS=localhost,127.0.0.1
SKILLPROOF_ORIGIN=http://127.0.0.1:4173

# 可选持久化绝对路径；默认使用 backend/data/skillproof.db
# SKILLPROOF_DB_PATH=E:/SkillProof-data/skillproof.db
